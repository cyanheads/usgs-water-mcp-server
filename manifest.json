{
  "manifest_version": "0.3",
  "name": "usgs-water-mcp-server",
  "version": "0.5.0",
  "description": "Query real-time and historical USGS water data from ~8,000 stream gages and groundwater wells.",
  "author": { "name": "cyanheads" },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/usgs-water-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/usgs-water-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "CANVAS_PROVIDER_TYPE": "none",
        "NODE_ENV": "production",
        "USGS_API_KEY": "${user_config.USGS_API_KEY}"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "USGS_API_KEY": {
      "type": "string",
      "title": "USGS API key",
      "description": "Optional api.data.gov key for the USGS Water Data APIs. Without one, requests share the anonymous per-IP hourly limit.",
      "sensitive": true,
      "required": false,
      "default": ""
    }
  }
}
